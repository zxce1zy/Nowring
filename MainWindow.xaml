<Window x:Class="Nowring.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nowring" Width="388" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        Foreground="{DynamicResource Text}">
    <Window.Resources>

        <!-- переключатель с анимацией -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel Background="Transparent" LastChildFill="True">
                            <Grid DockPanel.Dock="Right" Width="38" Height="20" VerticalAlignment="Center">
                                <Border CornerRadius="10" Background="{DynamicResource Off}"/>
                                <Border x:Name="On" CornerRadius="10" Background="{DynamicResource Accent}" Opacity="0"/>
                                <Ellipse Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="KnobT"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobT" Storyboard.TargetProperty="X"
                                                             To="18" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="KnobT" Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{DynamicResource Card}" CornerRadius="10" Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- кнопки заголовка: свернуть и закрыть -->
        <Style x:Key="TitleBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Title}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource TitleBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#ED4245"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                            <Border x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2"
                                        Background="{TemplateBinding Foreground}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Margin="14" CornerRadius="18" Opacity="0"
            Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Edge}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideT"/>
        </Border.RenderTransform>

        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- заголовок окна: за него можно перетаскивать -->
        <Grid x:Name="TitleBar" Height="46" Background="Transparent" MouseLeftButtonDown="OnDrag">
            <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource Accent}">
                    <TextBlock Text="♪" Foreground="White" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Symbol"/>
                </Border>
                <TextBlock Text="Nowring" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource Title}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                <Button Style="{StaticResource TitleBtn}" Click="OnMin" ToolTip="Свернуть">
                    <Path Data="M0,0.5 L10,0.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.4" Width="10" Height="1" Stretch="None"/>
                </Button>
                <Button Style="{StaticResource CloseBtn}" Click="OnClose" ToolTip="Закрыть" Margin="2,0,0,0">
                    <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="None"/>
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Margin="20,0,20,20">
            <!-- шапка -->
            <Grid>
                <TextBlock Text="СЕЙЧАС ИГРАЕТ" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Ellipse x:Name="DiscordDot" Width="8" Height="8" Margin="0,0,6,0"/>
                    <TextBlock x:Name="DiscordText" FontSize="11" Foreground="{DynamicResource Sub}"/>
                </StackPanel>
            </Grid>

            <!-- трек -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="96" Height="96" CornerRadius="14" Background="{DynamicResource CoverBg}">
                    <Border CornerRadius="14">
                        <Border.Background>
                            <ImageBrush x:Name="CoverBrush" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                </Border>
                <StackPanel x:Name="InfoPanel" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Title}"
                               TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="44"/>
                    <TextBlock x:Name="ArtistText" Margin="0,3,0,0" Foreground="{DynamicResource Sub}"
                               TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="36"/>
                    <Border x:Name="SourceChip" Margin="0,8,0,0" HorizontalAlignment="Left" CornerRadius="8"
                            Background="{DynamicResource Chip}" Padding="8,2" Visibility="Collapsed">
                        <TextBlock x:Name="SourceText" FontSize="11" Foreground="{DynamicResource ChipText}"/>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- прогресс -->
            <ProgressBar x:Name="Progress" Margin="0,16,0,0" Height="4" Minimum="0" Maximum="1"
                         Background="{DynamicResource Track}" Foreground="{DynamicResource Accent}"/>
            <Grid Margin="0,5,0,0">
                <TextBlock x:Name="PosText" FontSize="11" Foreground="{DynamicResource Muted}"/>
                <TextBlock x:Name="DurText" FontSize="11" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right"/>
            </Grid>

            <Rectangle Height="1" Fill="{DynamicResource Divider}" Margin="0,16,0,12"/>

            <!-- настройки -->
            <TextBlock Text="ИСТОЧНИКИ" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/>
            <CheckBox x:Name="SpotifyCb" Content="Spotify" Click="OnToggle"/>
            <CheckBox x:Name="YandexCb" Content="Яндекс Музыка" Click="OnToggle"/>
            <CheckBox x:Name="BrowserCb" Content="Браузер (SoundCloud и др.)" Click="OnToggle"/>

            <TextBlock Text="ПРОЧЕЕ" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" Margin="0,12,0,4"/>
            <CheckBox x:Name="EnabledCb" Content="Статус активности в Discord" Click="OnToggle"/>
            <CheckBox x:Name="CoversCb" Content="Показывать обложки" Click="OnToggle"/>
            <CheckBox x:Name="ButtonCb" Content="Кнопка «Открыть в…» в карточке" Click="OnToggle"/>
            <CheckBox x:Name="DarkCb" Content="Тёмная тема" Click="OnToggle"/>
            <CheckBox x:Name="AutostartCb" Content="Запускать вместе с Windows" Click="OnToggle"/>

            <TextBlock x:Name="Hint" Visibility="Collapsed" Margin="0,10,0,0" FontSize="11" TextWrapping="Wrap"
                       Foreground="{DynamicResource Muted}" Cursor="Hand" MouseLeftButtonUp="OnHint"
                       Text="Если в Discord видны две активности: Настройки → Подключения → Spotify → выключите «Показывать Spotify как статус». (Нажмите, чтобы скрыть.)"/>

            <Button Content="Выйти из приложения" Margin="0,16,0,0" Click="OnQuit"/>
        </StackPanel>
        </Grid>
    </Border>
</Window>
