<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Nowring</AssemblyName>
    <RootNamespace>Nowring</RootNamespace>

    <!-- сведения о программе (версию в CI подставляет тег релиза: -p:Version=...) -->
    <Version>3.1.0</Version>
    <Product>Nowring</Product>
    <Authors>zxce1zy</Authors>
    <Description>Music in Discord: Rich Presence for Spotify, Yandex Music and SoundCloud</Description>
    <Copyright>Copyright (c) 2026 zxce1zy</Copyright>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>

    <!-- один самодостаточный .exe -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtraction>true</IncludeNativeLibrariesForSelfExtraction>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- минимум памяти -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- InvariantGlobalization нельзя: WPF при вводе текста запрашивает культуру раскладки (ru-RU) и падает.
         UseNls берёт данные у Windows без загрузки ICU, поэтому памяти почти не прибавляется. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Globalization.UseNls" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\logo.png" />
    <!-- Lyrics Overlay (тексты песен на экране): лежит внутри Nowring.exe и распаковывается при первом запуске -->
    <EmbeddedResource Include="lyrics\LyricsOverlay.exe" LogicalName="LyricsOverlay.exe" />
  </ItemGroup>

  <!-- Lyrics Overlay пересобирается сам, когда изменился lyrics\source\lyrics_overlay_v3.py (нужен Python 3.12).
       Нет Python или сборка не удалась: берётся готовый lyrics\LyricsOverlay.exe. Отключить: -p:SkipLyricsBuild=true -->
  <Target Name="BuildLyrics" BeforeTargets="BeforeBuild"
          Inputs="lyrics\source\lyrics_overlay_v3.py;lyrics\source\build_exe.py" Outputs="lyrics\LyricsOverlay.exe"
          Condition="'$(OS)' == 'Windows_NT' And '$(SkipLyricsBuild)' != 'true'">
    <Exec Command="py -3.12 &quot;lyrics\source\build_exe.py&quot; --auto || python &quot;lyrics\source\build_exe.py&quot; --auto"
          WorkingDirectory="$(MSBuildProjectDirectory)" ContinueOnError="true" IgnoreExitCode="true">
      <Output TaskParameter="ExitCode" PropertyName="LyricsExit" />
    </Exec>
    <Warning Condition="'$(LyricsExit)' != '0'" Text="Lyrics Overlay не пересобран (нужен Python 3.12), используется готовый lyrics\LyricsOverlay.exe" />
  </Target>

</Project>
